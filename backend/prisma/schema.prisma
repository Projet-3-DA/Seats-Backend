
generator client {
  provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Utilisateur {
    id Int @id @default(autoincrement())
    email String @unique
    motDePasse String
    nom String
    prenom String
    role Role
    createdAt DateTime @default(now())

    salles Salle[]
    evenements Evenement[]
    reservations Reservation[]
}

enum Role{
    spectateur
    organisateur
    administrateur
}

model Salle{
    id Int @id @default(autoincrement())
    organisateurId Int
    organisateur Utilisateur @relation(fields: [organisateurId], references: [id])
    nom String
    nombreRangees Int
    siegesParRangee Int
    createdAt DateTime @default(now())

    sieges Siege[]
    evenements Evenement[]
    sections Section[]

    @@unique([organisateurId,nom])
}

// Section tarifaire d'une salle (#11), ex. parterre, balcon. Un siège sans section est vendu au tarif
// de l'événement.
model Section {
    id Int @id @default(autoincrement())
    salleId Int
    salle Salle @relation(fields: [salleId], references: [id], onDelete: Cascade)
    nom String
    prix Decimal @db.Decimal(8, 2)
    // Couleur d'affichage sur les plans (#34), au format #RRGGBB.
    couleur String
    createdAt DateTime @default(now())

    sieges Siege[]

    @@unique([salleId, nom])
}

model Siege{
    id Int @id @default(autoincrement())
    salleId Int
    salle Salle @relation(fields: [salleId], references: [id])
    numeroRangee Int
    numeroColonne Int
    createdAt DateTime @default(now())
    // Un siège appartient à au plus une section à la fois (#11).
    sectionId Int?
    section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

    reservations Reservation[]

    @@unique([salleId, numeroRangee, numeroColonne])
}

model Evenement{
    id Int @id @default(autoincrement())
    organisateurId Int
    organisateur Utilisateur @relation(fields: [organisateurId], references: [id])
    salleId Int
    salle Salle @relation(fields: [salleId], references: [id])
    titre String
    description String?
    afficheUrl String?
    dateHeure DateTime
    tarif Decimal? @db.Decimal(8, 2)
    createdAt DateTime @default(now())

    reservations Reservation[]
}

model Reservation {
  id               Int              @id @default(autoincrement())
  spectateurId     Int
  spectateur       Utilisateur      @relation(fields: [spectateurId], references: [id])
  siegeId          Int
  siege            Siege            @relation(fields: [siegeId], references: [id])
  evenementId      Int
  evenement        Evenement        @relation(fields: [evenementId], references: [id])
  statut           StatutReservation
  dateSelection    DateTime         @default(now())
  dateConfirmation DateTime?
  delaiExpiration  DateTime
  // Annulation par l'organisateur (#14) : la réservation reste dans l'historique du spectateur.
  motifAnnulation  String?
  dateAnnulation   DateTime?
  // true tant que la réservation occupe le siège, NULL une fois annulée. Postgres considère deux NULL
  // comme différents dans une contrainte unique : les réservations annulées s'accumulent sans bloquer
  // le siège, et il ne peut toujours y avoir qu'une seule réservation active par siège (#16, #27, #38).
  actif            Boolean?         @default(true)

  @@unique([siegeId, evenementId, actif])
}

enum StatutReservation {
  en_selection
  confirmee
  annulee
}




