# Base de données (Supabase)
DATABASE_URL=
DIRECT_URL=

# Clé de signature des tokens JWT. Longue chaîne aléatoire, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Stockage des affiches d'événements (Supabase Storage)
# URL du projet, ex. https://<ref-du-projet>.supabase.co
SUPABASE_URL=
# Clé "service_role" (Project Settings > API). Secrète : uniquement dans ce .env, jamais dans le frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket public à créer dans Storage (par défaut : affiches)
SUPABASE_BUCKET=affiches

# Connexion avec GitHub (OAuth App : GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL de l'OAuth App : http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
# Secret de l'OAuth App. Secret : uniquement dans ce .env, jamais dans le frontend ni dans Git.
GITHUB_CLIENT_SECRET=
# Facultatifs : à changer seulement si les ports ou l'adresse diffèrent.
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# FRONTEND_URL=http://localhost:5173

# Connexion OpenID Connect (#114). Un fournisseur sans ID/secret est désactivé (bouton « Bientôt »).
# Callback à déclarer chez le fournisseur : http://localhost:3000/api/auth/<google|microsoft>/callback
# Google : console.cloud.google.com > API et services > Identifiants > ID client OAuth (application Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft : portal.azure.com > Microsoft Entra ID > Inscriptions d'applications (comptes personnels et professionnels)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Facultatif : adresse publique de l'API, utilisée pour construire les callbacks.
# BACKEND_URL=http://localhost:3000
